{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChemSSH Launcher",
  "version": "0.4.0",
  "identifier": "com.chemssh.launcher",
  "build": {
    "beforeDevCommand": "pnpm --dir frontend dev",
    "beforeBuildCommand": "pnpm --dir frontend build",
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ChemSSH Launcher",
        "width": 1200,
        "height": 800,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
