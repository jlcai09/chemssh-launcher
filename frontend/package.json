{
  "name": "chemssh-launcher-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "tauri": "tauri",
    "test": "pnpm run test:native-drag && pnpm run test:transfer-progress && pnpm run test:app-events && pnpm run test:terminal-flow-control && pnpm run test:tauri-bridge",
    "test:tauri-bridge": "node --experimental-strip-types --test tests/tauriBridge.test.mjs",
    "test:native-drag": "node --experimental-strip-types --test tests/nativeDrag.test.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5174",
    "test:transfer-progress": "node --experimental-strip-types --test tests/transferProgress.test.mjs",
    "test:app-events": "node --experimental-strip-types --test tests/appEvents.test.mjs",
    "test:terminal-flow-control": "node --experimental-strip-types --test tests/terminalFlowControl.test.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@tauri-apps/api": "^2.12.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "element-plus": "^2.9.6",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.3",
    "unplugin-element-plus": "^0.11.2",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0"
  }
}
